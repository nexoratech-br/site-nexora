---
import { Image } from 'astro:assets';
import aurea from '../../public/aurea-odonto-preview.png';
import imperial from '../../public/barbearia-imperial-preview.png';
import forno from '../../public/forno-27-preview.png';
const projects = [
    { name: 'Áurea Odonto', category: 'Odontologia', image: aurea, href: 'https://aurea-odonto.pages.dev', description: 'Uma apresentação cuidadosa para uma clínica odontológica, com tratamentos claros e um caminho simples até o agendamento.' },
    { name: 'Barbearia Imperial', category: 'Barbearia', image: imperial, href: 'https://barbearia-imperial.pages.dev', description: 'Serviços, estilo e personalidade em uma página que facilita o agendamento pelo WhatsApp.' },
    { name: 'Forno 27', category: 'Gastronomia', image: forno, href: 'https://forno-27.pages.dev', description: 'Sabores e produtos em destaque, com um caminho direto para quem quer fazer um pedido.' },
];
---
<section id="projetos" aria-labelledby="projects-title" class="nexora-section projects">
    <div class="section-shell">
        <p class="section-kicker">Projetos</p>
        <header class="section-heading">
            <h2 id="projects-title" class="section-title">Negócios diferentes.<br /><span>O mesmo cuidado.</span></h2>
            <p class="section-lead">Três projetos conceituais para mostrar como um site pode apresentar cada negócio com personalidade.</p>
        </header>
        <div class="project-showroom">
            {projects.map((project, index) => (
                <article class:list={['project', { 'project-featured': index === 0 }]} aria-labelledby={'project-title-' + index}>
                    <a class="project-image-link" href={project.href} target="_blank" rel="noopener noreferrer" aria-label={'Abrir projeto ' + project.name + ' em nova aba'}>
                        <Image src={project.image} alt={'Preview do projeto conceitual ' + project.name} widths={[480, 800, 1200, project.image.width].filter((width, i, values) => width <= project.image.width && values.indexOf(width) === i)} sizes={index === 0 ? '(max-width: 767px) calc(100vw - 48px), (max-width: 1100px) calc((100vw - 96px) * .6), (max-width: 1199px) calc((100vw - 144px) * .6), 701px' : '(max-width: 767px) calc(100vw - 48px), (max-width: 1100px) calc((100vw - 92px) / 2), (max-width: 1199px) calc((100vw - 140px) / 2), 586px'} width={project.image.width} format="webp" quality={85} loading="lazy" class="project-image" />
                    </a>
                    <div class="project-info">
                        <div class="project-identity">
                            <p class="project-category">{project.category} · Projeto conceitual</p>
                            <h3 id={'project-title-' + index}>{project.name}</h3>
                        </div>
                        <div class="project-summary">
                            <p>{project.description}</p>
                            <a class="text-link" href={project.href} target="_blank" rel="noopener noreferrer" aria-label={'Ver projeto ' + project.name + ' em nova aba'}>Ver projeto</a>
                        </div>
                    </div>
                </article>
            ))}
        </div>
    </div>
</section>
<style>
    .projects { background: #0e0d12; overflow: hidden; }
    .projects::before { content: ''; position: absolute; inset: 0; z-index: -1; background: radial-gradient(ellipse at 98% 34%, #38253f2b, transparent 48%); pointer-events: none; }
    .projects .section-shell { max-width: var(--desktop-shell, 1296px); }
    .projects .section-heading { margin-bottom: 40px; }
    .project-showroom { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 28px; row-gap: 44px; }
    .project { display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; align-content: start; min-width: 0; }
    .project-featured { grid-column: 1 / -1; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 32px; align-items: center; }
    .project-image-link { position: relative; display: block; overflow: hidden; background: #1b171f; box-shadow: 0 20px 48px #0003; }
    .project-image { display: block; width: 100%; height: auto; aspect-ratio: 1.65; object-fit: cover; object-position: top; transition: transform 450ms ease; }
    .image-open { position: absolute; bottom: 18px; right: 18px; display: grid; place-items: center; width: 45px; height: 45px; background: #0b0b0fe8; color: #e7d1fc; font-size: 25px; border: 1px solid #e0c9f533; }
    .project-info { min-width: 0; }
    .project-category { margin: 0 0 10px; font-size: 12px; line-height: 1.7; color: #c0a6d5; }
    h3 { margin: 0; font-size: clamp(30px, 2.8vw, 36px); line-height: 1.15; font-weight: 500; letter-spacing: -.04em; }
    .project-featured h3 { font-size: clamp(34px, 3.3vw, 42px); }
    .project-summary p { margin: 14px 0 8px; max-width: 480px; color: #c4bacb; font-size: 17px; line-height: 1.7; text-wrap: pretty; }
    @media (hover: hover) and (pointer: fine) { .project-image-link:hover .project-image { transform: scale(1.025); } }
    @media (max-width: 1100px) { .project-summary p { font-size: 16px; } }
    @media (max-width: 767px) {
        .project-showroom { grid-template-columns: minmax(0, 1fr); gap: 36px; }
        .project-featured { grid-column: auto; grid-template-columns: minmax(0, 1fr); gap: 20px; }
        .project-image { aspect-ratio: auto; object-fit: contain; }
        h3, .project-featured h3 { font-size: clamp(28px, 8vw, 33px); }
        .project-summary p { margin-top: 12px; font-size: 16px; line-height: 1.7; }
        .image-open { bottom: 12px; right: 12px; width: 40px; height: 40px; }
    }
</style>
