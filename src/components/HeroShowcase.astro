---
import HeroPreview from './HeroPreview.astro';
---
<figure class="showcase" aria-label="Estudo de apresentação do site Áurea em desktop e celular">
    <div class="device-stage" aria-hidden="true">
        <div class="cast-shadow"></div>
        <div class="laptop">
            <div class="desktop-preview">
                <div class="laptop-screen"><HeroPreview /></div>
            </div>
        </div>
        <div class="mobile-preview">
            <div class="phone-speaker"></div>
            <HeroPreview mobile />
            <div class="phone-home"></div>
        </div>
    </div>
</figure>
<style>
    .showcase { position: relative; min-width: 0; height: 405px; margin: 0; isolation: isolate; }
    .device-stage { position: absolute; inset: 0; perspective: 1800px; }
    .cast-shadow { position: absolute; width: 83%; height: 68%; top: 25%; left: 12%; transform: rotateZ(-6deg); border-radius: 30%; background: radial-gradient(ellipse, #05040890, transparent 70%); z-index: -1; }
    .laptop { position: absolute; top: -3px; left: 3%; width: 95%; transform: rotateY(-9deg) rotateX(2deg) rotateZ(-6deg); transform-style: preserve-3d; }
    .desktop-preview { position: relative; padding: 5px; border: 1px solid #e2cfe14f; border-radius: 6px; background: linear-gradient(145deg, #645b65, #29232e 35%, #17131c); box-shadow: 0 27px 48px #05040873, 0 5px 10px #0504085c, inset 0 1px 0 #ffffff40; overflow: hidden; }
    .laptop-screen { aspect-ratio: 1.85; overflow: hidden; border-radius: 2px; background: #eee9df; }
    .mobile-preview { position: absolute; z-index: 2; width: 132px; right: 0; top: 102px; aspect-ratio: .48; border: 5px solid #2b2630; border-radius: 24px; background: #eee9df; overflow: hidden; transform: rotateZ(5deg); box-shadow: 0 20px 36px #05040885, 0 0 0 1px #c5b3cb75, inset 0 1px 0 #fff4; }
    .phone-speaker { position: absolute; z-index: 3; width: 35px; height: 8px; border-radius: 10px; top: 5px; left: calc(50% - 17.5px); background: #19151e; }
    .phone-home { position: absolute; bottom: 5px; left: 35%; width: 30%; height: 3px; border-radius: 5px; background: #f9f4ec; }
    @media (max-width: 1100px) and (min-width: 768px) {
        .showcase { height: 355px; margin-top: 17px; }
        .laptop { width: 101%; top: 10px; left: 0; }
        .mobile-preview { width: 114px; top: 84px; right: 0; border-radius: 21px; }
    }
    @media (max-width: 767px) {
        .showcase { height: clamp(305px, 78vw, 470px); margin: 36px -4px 0; }
        .laptop { width: 95%; left: 0; top: 13px; transform: rotateZ(-5deg); }
        .laptop-screen { aspect-ratio: 1.5; } .desktop-preview { padding: 3px; border-radius: 5px; }
        .mobile-preview { width: clamp(102px, 27vw, 148px); top: clamp(69px, 18vw, 120px); right: 0; border-width: 4px; border-radius: 18px; }
        .phone-speaker { width: 30px; left: calc(50% - 15px); height: 7px; top: 4px; }
    }
    @media (prefers-reduced-motion: no-preference) {
        .device-stage { animation: showcase-enter 800ms ease-out both; }
        @keyframes showcase-enter { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
    }

    @media (min-width: 1200px) {
        .showcase { height: 350px; }
        .laptop { top: -12px; left: 1%; width: 96%; }
        .mobile-preview { top: 78px; right: 0; width: 126px; }
    }
</style>
