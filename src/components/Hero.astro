---
import HeroShowcase from './HeroShowcase.astro';
import HeroBackdrop from './HeroBackdrop.astro';
---
<section id="inicio" aria-labelledby="hero-title" class="hero relative overflow-hidden text-white">
    <HeroBackdrop />
    <div class="hero-inner mx-auto">
        <div class="hero-copy relative z-10">
            <h1 id="hero-title"><span class="headline-intro">Seu negócio <span class="intro-tail">já é bom.</span></span><span class="headline-statement">O site precisa <em>mostrar isso.</em></span></h1>
        </div>
        <div class="hero-body">
            <div class="hero-intro relative z-10">
                <p class="hero-description">Criamos sites para negócios locais que querem transmitir mais confiança, valor e profissionalismo desde o primeiro clique.</p>
                <div class="hero-actions flex flex-wrap items-center">
                    <a href="#contato" class="primary-cta inline-flex items-center justify-center">Quero meu site</a>
                    <a href="#projetos" class="secondary-cta inline-flex items-center">Ver projetos</a>
                </div>
            </div>
            <HeroShowcase />
        </div>
    </div>
</section>
<style>
    .hero { background: #0b0b0f; font-family: Arial, Helvetica, sans-serif; isolation: isolate; }
    .hero-inner { max-width: 1440px; padding: 163px 56px 53px; }
    h1 { margin: 0; font-size: clamp(43px, 5.9vw, 84px); line-height: 1.09; font-weight: 600; letter-spacing: -.057em; }
    .headline-intro, .headline-statement { display: block; }
    .headline-intro { color: #f2ede9; margin-bottom: 6px; }
    .intro-tail { white-space: nowrap; }
    .headline-statement { white-space: nowrap; }
    .headline-statement em { color: #b99bd8; font-style: normal; }
    .hero-body { display: grid; grid-template-columns: .78fr 1.22fr; gap: 54px; align-items: start; margin-top: 52px; }
    .hero-intro { padding-top: 45px; }
    .hero-description { max-width: 398px; font-size: 18px; line-height: 1.75; color: #c7c0c9; margin: 0; text-wrap: pretty; }
    .hero-actions { gap: 27px; margin-top: 30px; }
    .primary-cta { min-height: 60px; padding: 16px 22px; border: 1px solid #dfc9f44d; border-radius: 4px; background: #bc9bdf; color: #1c1423; font-size: 16px; font-weight: 700; white-space: nowrap; box-shadow: inset 0 1px 0 #fff3, 0 8px 22px #0003; transition: background 180ms, transform 180ms; }
    .primary-cta span { font-size: 23px; line-height: 1; }
    .primary-cta:hover { background: #d0b5ed; transform: translateY(-2px); }
    .secondary-cta { min-height: 48px; font-size: 16px; color: #d7ccd9; white-space: nowrap; text-underline-offset: 7px; transition: color 180ms; }
    .secondary-cta:hover { color: #ebd9fc; text-decoration: underline; } .secondary-cta span { font-size: 18px; }
    a:focus-visible { outline: 2px solid #e1c5ff; outline-offset: 5px; }
    @media (max-width: 1100px) and (min-width: 768px) {
        .hero-inner { padding: 145px 32px 45px; }
        h1 { font-size: clamp(43px, 5.85vw, 64px); }
        .hero-body { gap: 25px; grid-template-columns: .92fr 1.08fr; margin-top: 38px; }
        .hero-intro { padding-top: 28px; }
        .hero-description { font-size: 17px; line-height: 1.7; }
        .hero-actions { gap: 20px; }
        .primary-cta { padding-inline: 18px; font-size: 15px; }
        .secondary-cta { font-size: 15px; }
    }
    @media (max-width: 767px) {
        .hero-inner { padding: 119px 24px 40px; }
        h1 { font-size: clamp(39px, 10.65vw, 69px); line-height: 1.1; letter-spacing: -.05em; }
        .headline-intro { max-width: 520px; margin-bottom: 15px; }
        .headline-statement { white-space: normal; } .headline-statement em { display: block; }
        .hero-body { grid-template-columns: minmax(0, 1fr); gap: 0; margin-top: 26px; }
        .hero-intro { padding: 0; }
        .hero-description { max-width: 430px; font-size: 17px; line-height: 1.65; }
        .hero-actions { gap: 24px; margin-top: 26px; }
        .primary-cta { min-height: 58px; padding-inline: 19px; font-size: 15px; }
        .secondary-cta { font-size: 15px; }
    }
    @media (max-width: 359px) {
        .hero-inner { padding-inline: 20px; }
        h1 { font-size: 37px; }
        .hero-actions { gap: 18px; }
        .primary-cta { padding-inline: 15px; font-size: 14px; } .primary-cta span { font-size: 20px; }
        .secondary-cta { font-size: 14px; }
    }
    @media (prefers-reduced-motion: no-preference) {
        .hero-copy { animation: copy-enter 600ms ease-out both; }
        @keyframes copy-enter { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
    }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition: none !important; } }

    @media (min-width: 1200px) {
        .hero-inner { max-width: var(--desktop-shell); padding: 152px var(--desktop-gutter) 64px; }
        h1 { font-size: clamp(70px, 5.5vw, 78px); }
        .hero-body { grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: var(--desktop-gap); margin-top: 40px; align-items: center; }
        .hero-intro { padding-top: 0; padding-bottom: 48px; }
        .hero-description { max-width: 410px; }
        .hero-actions { gap: 24px; margin-top: 28px; }
    }
</style>
