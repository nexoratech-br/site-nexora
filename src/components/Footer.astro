---
import { Image } from 'astro:assets';
import logo from '../../public/nexora-icon.png';
import { whatsappUrl } from '../data/contact';
const year = new Date().getFullYear();
const links = [{ href: '#servicos', label: 'Serviços' }, { href: '#como-funciona', label: 'Como funciona' }, { href: '#projetos', label: 'Projetos' }, { href: '#contato', label: 'Contato' }];
---
<footer class="nexora-footer">
    <div class="footer-shell">
        <div class="footer-main">
            <div class="footer-brand">
                <a class="footer-logo" href="#inicio" aria-label="Nexora Technology — início">
                    <Image src={logo} alt="" width={48} height={48} format="webp" loading="lazy" />
                    <span>NEXORA<small>TECHNOLOGY</small></span>
                </a>
                <p>Sites para negócios locais que querem se apresentar melhor e facilitar o contato com seus clientes.</p>
            </div>
            <nav aria-label="Navegação do rodapé">
                <p class="footer-label">Explore</p>
                {links.map(({ href, label }) => <a href={href}>{label}</a>)}
            </nav>
            <div class="footer-contact">
                <p class="footer-label">Contato</p>
                <p>Conte sobre seu negócio.<br />Vamos conversar sobre o site.</p>
                <a class="whatsapp-link" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Falar no WhatsApp<span class="sr-only"> — em nova aba</span></a>
            </div>
        </div>
        <div class="footer-bottom">
            <p>© {year} Nexora Technology. Todos os direitos reservados.</p>
            <a href="#inicio">Voltar ao topo <span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="12" height="20" viewBox="0 0 12 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M6 16V4M2 8l4-4 4 4" /></svg></span></a>
        </div>
    </div>
</footer>
<style>
    .nexora-footer { background: #0b0b0f; }
    .footer-shell { padding-block: 70px 25px; }
    .footer-main { display: grid; grid-template-columns: 1.25fr .6fr .75fr; gap: 70px; padding-bottom: 52px; }
    .footer-logo { display: inline-flex; align-items: center; gap: 12px; min-height: 48px; }
    .footer-logo img { width: 43px; height: 43px; }
    .footer-logo > span { font-size: 22px; font-weight: 700; letter-spacing: .09em; line-height: 1; }
    .footer-logo small { display: block; font-size: 10px; letter-spacing: .27em; color: #b8adbf; margin-top: 7px; }
    .footer-brand p { max-width: 340px; margin: 24px 0 0; font-size: 16px; line-height: 1.75; color: #bdb2c6; }
    .footer-label { margin: 0 0 17px; color: #d0b7e1; font-size: 12px; line-height: 1.6; letter-spacing: .09em; text-transform: uppercase; }
    nav a { display: block; width: fit-content; min-height: 44px; padding-block: 11px; font-size: 15px; color: #d8ccdF; }
    nav a:hover, .whatsapp-link:hover, .footer-bottom a:hover { color: #e7c9ff; text-decoration: underline; text-underline-offset: 5px; }
    .footer-contact > p:not(.footer-label) { margin: 0 0 13px; font-size: 16px; line-height: 1.75; color: #bdb2c6; }
    .whatsapp-link { display: inline-flex; align-items: center; min-height: 48px; font-size: 16px; color: #dfc5f2; }
    .footer-bottom { display: flex; align-items: center; justify-content: space-between; gap: 24px; border-top: 1px solid #cab1d523; padding-top: 20px; color: #b0a3ba; font-size: 12px; line-height: 1.7; }
    .footer-bottom p { margin: 0; } .footer-bottom a { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; white-space: nowrap; } .footer-bottom a span { font-size: 20px; }
    @media (max-width: 1100px) { .footer-main { gap: 35px; grid-template-columns: 1fr .65fr .85fr; } }
    @media (max-width: 767px) {
        .footer-shell { padding-block: 52px 24px; }
        .footer-main { grid-template-columns: 1fr 1fr; gap: 35px 22px; padding-bottom: 30px; }
        .footer-brand { grid-column: 1 / -1; } .footer-brand p { max-width: 400px; margin-top: 20px; }
        .footer-contact > p:not(.footer-label) { font-size: 15px; } .whatsapp-link { font-size: 15px; }
        .footer-bottom { display: grid; grid-template-columns: 1fr; gap: 10px; font-size: 12px; }
    }
    @media (max-width: 359px) { .footer-main { column-gap: 16px; } .whatsapp-link { font-size: 14px; } }

    @media (min-width: 1200px) {
        .footer-main { gap: var(--desktop-gap); }
    }
</style>
