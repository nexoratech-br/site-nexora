<nav class="w-full bg-[#0B0B0F] fixed top-0 left-0 z-50">
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">

        <div class="text-purple-400 text-lg font-bold">
            NEXORA
        </div>

        <div class="hidden md:flex gap-6">
            <a class="text-gray-300 hover:text-purple-400" href="#servicos">Serviços</a>
            <a class="text-gray-300 hover:text-purple-400" href="#projetos">Projetos</a>
            <a class="text-gray-300 hover:text-purple-400" href="#contato">Contato</a>
        </div>

        <button id="menu-btn" class="md:hidden flex text-purple-400 text-2xl cursor-pointer">
            ☰
        </button>

    </div>

    <div id="mobile-menu" class="hidden flex flex-col gap-4 px-6 pb-4 text-gray-300">
        <a class="hover:text-purple-400" href="#servicos">Serviços</a>
        <a class="hover:text-purple-400" href="#projetos">Projetos</a>
        <a class="hover:text-purple-400" href="#contato">Contato</a>
    </div>

</nav>

<script>
    const menuBtn = document.getElementById("menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const mobileLinks = mobileMenu.querySelectorAll("a");
    menuBtn.addEventListener("click", () => {
        mobileMenu.classList.toggle("hidden");
    });
    mobileLinks.forEach((link) => {
        link.addEventListener("click", () => {
            mobileMenu.classList.add("hidden");
        })
    });
</script>